<h1>Product List</h1>
<p class="read-only-notice">Read-only mode: you can view, search and sort products.</p>
<div class="row">
   <a class="btn green" href="/product/sort/asc">Name ascending</a>
   <a class="btn lime" href="/product/sort/desc">Name descending</a>
</div>
<div class="row">
   <form class="col m5" action="/product/search" method="post">
      <input class="form-control" type="search" name="keyword"
      placeholder="Search by product name" required>
   </form>
</div>
<table class="table table-primary">
   <tr>
      <th>Product name</th>
      <th>Product price</th>
      <th>Product image</th>
      <th>Product category</th>
   </tr>
   {{#each productList }}
   <tr>
      <td>{{ name }}</td>
      <td>${{ price }}</td>
      <td>
         <img src="{{ imageUrl }}" alt="{{ name }}" width="100" height="100">
      </td>
      <td>{{ category.name }}</td>
   </tr>
   {{/each}}
</table>
